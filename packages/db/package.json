{
  "name": "@openschool/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-roles": "bun run src/provision-database-roles.ts",
    "db:execution-poc": "bun run src/database-execution-poc.ts",
    "db:push": "drizzle-kit push",
    "db:security-poc": "bun run src/security-poc.ts",
    "db:tenant-foundation-poc": "bun run src/tenant-foundation-poc.ts",
    "db:identity-foundation-poc": "bun run src/identity-foundation-poc.ts",
    "db:prepare-upgrade-fixture": "bun run src/prepare-upgrade-fixture.ts",
    "db:verify-upgrade-fixture": "bun run src/verify-upgrade-fixture.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts"
  },
  "dependencies": {
    "@openschool/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
