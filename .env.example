# OpenSchool local development configuration
# Copy with: bun run env:setup

# Public browser configuration. Use a dedicated development Supabase project,
# or replace both values with those from a complete local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Server-only PostgreSQL connections. Never prefix these variables with NEXT_PUBLIC_.
# The migration credential owns schema changes. Product and background work must
# use distinct non-owner, NOBYPASSRLS roles provisioned by `bun run db:provision-roles`.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_MIGRATION_ROLE=postgres
DATABASE_RUNTIME_URL=postgresql://openschool_runtime:runtime-local-only@127.0.0.1:54322/postgres
DATABASE_RUNTIME_ROLE=openschool_runtime
DATABASE_WORKER_URL=postgresql://openschool_worker:worker-local-only@127.0.0.1:54322/postgres
DATABASE_WORKER_ROLE=openschool_worker

# Production rollback disables the vertical slice; it never restores owner access.
OPENSCHOOL_STUDENT_SLICE_MODE=forced_rls

# Optional rollback selector. Omit to use the current accepted policy bundle.
# OPENSCHOOL_POLICY_VERSION=2026-08-02.legacy-parity

# Local subdomain routing.
NEXT_PUBLIC_APP_URL=http://app.openschool.local:3000
NEXT_PUBLIC_WWW_URL=http://www.openschool.local:3000
